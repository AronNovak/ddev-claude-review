#!/bin/bash

## Description: Review a pull request using Claude CLI
## Usage: review [--post] [pr_url]
## Example: review https://github.com/org/repo/pull/123
## Example: review 123
## Example: review --post 123  # Post review comments to GitHub

set -eu -o pipefail

# Parse command line arguments
POST_REVIEW=false
PR_ARG=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --post|-p)
      POST_REVIEW=true
      shift
      ;;
    *)
      PR_ARG="$1"
      shift
      ;;
  esac
done

# Check if PR URL/number is provided
if [ -z "$PR_ARG" ]; then
  echo "Error: PR URL or number is required"
  echo "Usage: review [--post] [pr_url|pr_number]"
  echo "  --post, -p    Post review comments to GitHub automatically"
  exit 1
fi

# Checkout the PR branch (suppress standard messages)
if ! gh pr checkout "$PR_ARG" 2>&1 | grep -v "^Already on" | grep -v "^Your branch is up to date" | grep -v "^Already up to date"; then
  if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "Error: Failed to checkout PR"
    exit 1
  fi
fi

# Get PR metadata first
PR_INFO=$(gh pr view "$PR_ARG" --json title,author,body,number,url)
PR_TITLE=$(echo "$PR_INFO" | jq -r '.title')
PR_AUTHOR=$(echo "$PR_INFO" | jq -r '.author.login')
PR_NUMBER=$(echo "$PR_INFO" | jq -r '.number')
PR_BODY=$(echo "$PR_INFO" | jq -r '.body')
PR_URL=$(echo "$PR_INFO" | jq -r '.url')

# Build output instructions based on mode
if [ "$POST_REVIEW" = true ]; then
  REVIEW_MODE_INSTRUCTION=$(cat <<EOF
Output Instructions:
- Post each issue as an inline GitHub review comment using "gh pr review $PR_NUMBER --comment --body \"line comment\" --path \"file/path.php\" --line LINE_NUMBER".
- Add "--start-line" when you need to reference a multi-line span.
- After the inline comments, send a short overall summary comment with "gh pr review $PR_NUMBER --comment --body \"overall summary\"".
- Make sure every comment names the exact file path and 1-based line numbers from the diff.
EOF
)
else
  REVIEW_MODE_INSTRUCTION=$(cat <<EOF
Output Instructions:
- Report the entire review in this terminal output.
- Do not run "gh pr review".
EOF
)
fi

# Create the review prompt
REVIEW_PROMPT=$(cat <<EOF
Please review pull request $PR_NUMBER for Drupal best practices and overall quality.

Title: $PR_TITLE
Author: @$PR_AUTHOR
URL: $PR_URL

Description:
$PR_BODY

Preparation:
- Fetch the diff yourself by running "gh pr diff $PR_NUMBER". If it is too large, redirect it to "/tmp/pr_${PR_NUMBER}_diff.txt" and read from there.
- Concentrate on code quality, potential bugs, security, performance, and Drupal coding standards.
- Do not run or suggest linting tools.

$REVIEW_MODE_INSTRUCTION

Deliverable:
- Summary of the changes and overall risk level.
- Specific issues with file paths and precise line numbers.
- Actionable suggestions or follow-ups.
EOF
)

# Invoke Claude CLI for code review
echo "Reviewing PR #$PR_NUMBER: $PR_TITLE"
if [ "$POST_REVIEW" = true ]; then
  echo "Mode: Will post review comments to GitHub"
else
  echo "Mode: Display-only (use --post to post comments to GitHub)"
fi
echo ""
claude --print "$REVIEW_PROMPT"

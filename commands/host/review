#!/bin/bash

## Description: Review a pull request using Claude CLI
## Usage: review [--post] [pr_url]
## Example: review https://github.com/org/repo/pull/123
## Example: review 123
## Example: review --post 123  # Post review comments to GitHub

set -eu -o pipefail

# Parse command line arguments
POST_REVIEW=false
PR_ARG=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --post|-p)
      POST_REVIEW=true
      shift
      ;;
    *)
      PR_ARG="$1"
      shift
      ;;
  esac
done

# Check if PR URL/number is provided
if [ -z "$PR_ARG" ]; then
  echo "Error: PR URL or number is required"
  echo "Usage: review [--post] [pr_url|pr_number]"
  echo "  --post, -p    Post review comments to GitHub automatically"
  exit 1
fi

# Checkout the PR branch (suppress standard messages)
if ! gh pr checkout "$PR_ARG" 2>&1 | grep -v "^Already on" | grep -v "^Your branch is up to date" | grep -v "^Already up to date"; then
  if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "Error: Failed to checkout PR"
    exit 1
  fi
fi

# Get PR metadata first
PR_INFO=$(gh pr view "$PR_ARG" --json title,author,body,number,url)
PR_TITLE=$(echo "$PR_INFO" | jq -r '.title')
PR_AUTHOR=$(echo "$PR_INFO" | jq -r '.author.login')
PR_NUMBER=$(echo "$PR_INFO" | jq -r '.number')
PR_BODY=$(echo "$PR_INFO" | jq -r '.body')
PR_URL=$(echo "$PR_INFO" | jq -r '.url')

# Create the review prompt
REVIEW_PROMPT="Please review this pull request code.

PR #$PR_NUMBER: $PR_TITLE
Author: @$PR_AUTHOR
URL: $PR_URL

Description:
$PR_BODY

IMPORTANT INSTRUCTIONS:
1. Fetch the PR diff using: gh pr diff $PR_NUMBER
   - If the diff is too large to read in one go, write it to a temporary file first:
     gh pr diff $PR_NUMBER > /tmp/pr_${PR_NUMBER}_diff.txt
     Then read the file: cat /tmp/pr_${PR_NUMBER}_diff.txt

2. Review the code focusing on:
   - Code quality and best practices
   - Potential bugs or issues
   - Security concerns
   - Performance implications
   - Drupal coding standards compliance

3. Do NOT run or suggest linting tools.

4. POST_REVIEW_MODE: $POST_REVIEW
   - If POST_REVIEW_MODE is 'true', automatically post your review comments to GitHub using:
     gh pr review $PR_NUMBER --comment -b \"your review summary\"
   - For specific line comments, you can use:
     gh pr review $PR_NUMBER --comment -b \"review summary\" --body \"line comment\" --path \"file/path.php\" --line LINE_NUMBER
   - If POST_REVIEW_MODE is 'false', just display your review findings in the terminal output.

5. Format your review clearly with:
   - A summary of the changes
   - Specific issues found (with file paths and line numbers)
   - Suggestions for improvements
   - Positive feedback on good practices"

# Invoke Claude CLI for code review
echo "Reviewing PR #$PR_NUMBER: $PR_TITLE"
if [ "$POST_REVIEW" = true ]; then
  echo "Mode: Will post review comments to GitHub"
else
  echo "Mode: Display-only (use --post to post comments to GitHub)"
fi
echo ""
claude --print "$REVIEW_PROMPT"
